hh_it_vacancies.csv

# Персональные данные — не выкладываем
*.pdf

# Письма и локальные БД (генерируются приложением)
outbox/
*.db
*.db-wal
*.db-shm
*.sqlite

# Системный мусор
Thumbs.db
.DS_Store
